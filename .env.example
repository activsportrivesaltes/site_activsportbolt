# ============================================================================
# Activ' Sport Rivesaltes — Variables d'environnement (serveur Node.js)
# ============================================================================
# Copiez ce fichier en ".env" et remplissez les vraies valeurs.
# Le fichier ".env" ne doit JAMAIS être commité (déjà dans .gitignore).
#
# En production, ce fichier n'existe QUE sur le serveur Infomaniak (déposé
# manuellement par SSH/SFTP à la racine du site, à côté de server.js),
# jamais dans le dépôt Git. La commande de démarrage configurée dans le
# Manager Infomaniak (Site Node.js > Paramètres avancés) doit être :
#   node --env-file=.env server.js
# ============================================================================

# --- SMTP (ksuite / mail Infomaniak) -----------------------------------------
# mail.infomaniak.com, port 587 (STARTTLS, SMTP_SECURE=false) ou port 465
# (SSL/TLS implicite, SMTP_SECURE=true). Utilisez l'adresse mail complète
# comme identifiant, et un "mot de passe d'application" (mot de passe
# d'appareil) plutôt que le mot de passe principal du compte :
#   1. https://ksuite.infomaniak.com/mail
#   2. Paramètres de l'adresse > Mots de passe des appareils > Nouvel appareil
#   3. Nom : "Site web - formulaire contact", onglet IMAP/SMTP
#   4. Copiez le mot de passe généré (affiché une seule fois) dans SMTP_PASS.
SMTP_HOST=mail.infomaniak.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=contact@activsportrivesaltes.fr
SMTP_PASS=changeme_mot_de_passe_application

# Adresse affichée comme expéditeur (doit correspondre à SMTP_USER ou à un
# alias autorisé sur ce compte kSuite)
MAIL_FROM=contact@activsportrivesaltes.fr

# Adresse qui reçoit les messages de contact
MAIL_TO=activsportrivesaltes@etik.com

# URL publique du logo utilisé dans le corps des emails (URL absolue, un
# client mail ne peut pas charger un chemin relatif)
MAIL_LOGO_URL=https://activsportrivesaltes.fr/images/Logo_ActivSportRiv.jpg

# Port d'écoute du serveur (doit correspondre au "Port d'écoute" réglé dans
# le Manager Infomaniak, actuellement 3000)
PORT=3000
